# Project
ENVIRONMENT=local
LOG_LEVEL=INFO

# Kaggle ingestion
KAGGLE_DATASET_SLUG=your-kaggle-owner/your-retail-sales-dataset
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
KAGGLE_CONFIG_DIR=.kaggle

# Local file storage
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VALIDATION_OUTPUT_DIR=data/validation

# PostgreSQL warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=retail_sales
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_password
POSTGRES_SCHEMA=analytics

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://retail_user:retail_password@postgres:5432/airflow

# Streamlit
STREAMLIT_SERVER_PORT=8501
